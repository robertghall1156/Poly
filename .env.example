# Copy to .env and edit. Never commit .env.

# ---------- Database ----------
# Default: SQLite file under ./data (zero setup).
# For Postgres + pgvector via docker compose use:
# POLY_DATABASE_URL=postgresql+psycopg://poly:poly@localhost:5432/poly
POLY_DATABASE_URL=sqlite:///./data/poly.db

# ---------- Paths ----------
POLY_DATA_DIR=./data
POLY_KNOWLEDGE_FILE=./knowledge/political_operating_system.md
POLY_FFMPEG_PATH=ffmpeg
POLY_FFPROBE_PATH=ffprobe

# ---------- Local AI (defaults are auto-detected at startup) ----------
POLY_OLLAMA_URL=http://localhost:11434
# Extra OpenAI-compatible local servers (LM Studio, llama.cpp, vLLM, MLX), comma separated
POLY_OPENAI_COMPAT_URLS=http://localhost:1234/v1

# ---------- Privacy defaults (can be changed in Settings → Privacy & Network) ----------
POLY_LOCAL_AI_ONLY=true
POLY_ALLOW_INTERNET_RESEARCH=true
POLY_ALLOW_CLOUD_AI=false

# ---------- Optional cloud AI (disabled unless Allow Cloud AI is ON) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Optional news/search APIs (RSS works without any of these) ----------
BRAVE_API_KEY=
TAVILY_API_KEY=
NEWSAPI_KEY=

# ---------- Optional local image generation (leave empty to keep disabled) ----------
# e.g. http://localhost:8188 for ComfyUI, http://localhost:7860 for Automatic1111,
# or any OpenAI-images-compatible local endpoint
POLY_LOCAL_IMAGE_URL=
POLY_LOCAL_IMAGE_KIND=

# ---------- Server ----------
POLY_HOST=127.0.0.1
POLY_PORT=8000
NEXT_PUBLIC_POLY_API=http://localhost:8000
# Daily ingest time (24h, local time)
POLY_DAILY_INGEST_HOUR=6
POLY_DAILY_INGEST_MINUTE=30
